<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>ecfb317e-d177-4a98-bdf1-5592594a3233</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include=".\VolleyballApp.Controller\VolleyballApp.Controller.csproj" />
    <ProjectReference Include=".\VolleyballApp.Repository\VolleyballApp.Repository.csproj" />
    <ProjectReference Include=".\VolleyballApp.Service\VolleyballApp.Service.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Controllers\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="VolleyballApp.Model\**\*.cs" />
    <Compile Remove="VolleyballApp.Repository\**\*.cs" />
    <Compile Remove="VolleyballApp.Service\**\*.cs" />
    <Compile Remove="VolleyballApp.Controller\**\*.cs" />
</ItemGroup>

</Project>
